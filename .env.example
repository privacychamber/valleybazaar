# Valley Bazaar — Environment Variable Specification
# Copy this file to .env.local for local development

# 1. APPLICATION ENVIRONMENT
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# 2. DATABASE (Planned PostgreSQL)
# Unconfigured in Demo Mode; mock repository handles data
DATABASE_URL="postgresql://user:password@localhost:5432/valleybazaar?schema=public"

# 3. AUTHENTICATION (Auth.js / NextAuth boundary)
AUTH_SECRET="your-32-character-random-secret-key-here"
AUTH_URL="http://localhost:3000/api/auth"

# 4. TRANSACTIONAL EMAIL (SMTP / Resend / AWS SES)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=notifications@valleybazaar.sample
EMAIL_PASSWORD=your-smtp-password

# 5. S3-COMPATIBLE OBJECT STORAGE (Cloudflare R2 / AWS S3 / MinIO)
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_BUCKET=valleybazaar-media
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key

# 6. PAYMENT GATEWAY (Razorpay / Cashfree)
# Remains disabled in Demo Mode
PAYMENT_PROVIDER=RAZORPAY
PAYMENT_PUBLIC_KEY=rzp_test_your_key_here
PAYMENT_SECRET_KEY=your_secret_key_here
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

